# R session state
.Rhistory
.Rapp.history
.RData
.Ruserdata
.Rproj.user/
*.Rproj
.Rbuildignore

# Local environment and secrets
.Renviron
.Renviron.local
.env
.env.*
!.env.example
!.Renviron.example

# Local R libraries and package-build products
.Rlib/
*.Rcheck/
*.tar.gz

# renv machine-local state
renv/library/
renv/staging/
renv/python/
renv/local/
renv/cellar/
.renv-cache/
.renv-root/
.renv-library/

# targets cache
_targets/
_targets.RData

# Local operational material and generated execution state
internal/
archive/

# LaTeX build intermediates (the review PDF is copied to output/pdf/)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/main.pdf

# Downloaded source data and regenerated analysis outputs. The compact,
# versioned inputs under data/analysis/ remain public.
data/raw/
data/processed/

# Generated presentation products
output/

# Generated Stan/C++ build products (Stan sources remain tracked)
scripts/stan/*.hpp
scripts/stan/*.o
scripts/stan/*.d
scripts/stan/*.rds

# Temporary files
tmp/
temp/
*.tmp
*.swp

# Local and cluster runtime logs
logs/
slurm-*.out
slurm-*.err
.hpc-env/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
.positai
